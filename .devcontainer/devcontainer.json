{
    "name": "BillDrift",
    "image": "mcr.microsoft.com/devcontainers/dotnet:dev-10.0-noble",
    "features": {
        "ghcr.io/microsoft/aspire-devcontainer-feature/aspire:3": {},
        "ghcr.io/devcontainers/features/azure-cli:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "2"
        },
        "ghcr.io/devcontainers/features/docker-in-docker:4": {},
        "ghcr.io/devcontainers/features/python:1": {
            "version": "os-provided"
        },
        "ghcr.io/devcontainers-extra/features/uv:1": {},
        "ghcr.io/devcontainers/features/powershell:2": {},
        "ghcr.io/stu-bell/devcontainer-features/cursor-cli:0": {}
    },
    "containerEnv": {
        "SSL_CERT_DIR": "/home/vscode/.aspnet/dev-certs/trust:/usr/lib/ssl/certs"
    },
    "remoteEnv": {
        "SSL_CERT_DIR": "/usr/lib/ssl/certs:/home/vscode/.aspnet/dev-certs/trust"
    },
    "onCreateCommand": "sudo apt-get update && sudo apt-get install -y libnss3-tools",
    "updateContentCommand": "dotnet restore BillDrift.slnx && dotnet restore src/BillDrift.AppHost/BillDrift.AppHost.csproj",
    "hostRequirements": {
        "cpus": 4,
        "memory": "8gb",
        "storage": "32gb"
    },
    "postStartCommand": "bash -lc \"aspire certs trust --non-interactive && docker rm -f azurite 2>/dev/null || true && docker run -d --name azurite -p 10000:10000 -p 10001:10001 -p 10002:10002 mcr.microsoft.com/azure-storage/azurite:latest azurite --skipApiVersionCheck --blobHost 0.0.0.0 --queueHost 0.0.0.0 --tableHost 0.0.0.0\"",
    "postCreateCommand": "bash .devcontainer/setup-spec-kit.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "GitHub.copilot-chat",
                "microsoft-aspire.aspire-vscode"
            ]
        }
    }
}